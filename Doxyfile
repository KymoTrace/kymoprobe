PROJECT_NAME           = KymoProbe
PROJECT_BRIEF          = "Portable embedded telemetry: configuration, Init and cyclic Main"
OUTPUT_DIRECTORY       = docs/api
INPUT                  = docs/api.dox \
                         lib/KymoCore/src/common/embedded_bits.h \
                         lib/KymoCore/src/common/embedded_bytes.h \
                         lib/KymoCore/src/common/embedded_crc.h \
                         lib/KymoCore/src/control/kymo_control_rx.h \
                         lib/KymoCore/src/control/kymo_param.h \
                         lib/KymoCore/src/control/kymo_watch.h \
                         lib/KymoCore/src/endpoint/features/kymo_memory.h \
                         lib/KymoCore/src/endpoint/features/kymo_param.h \
                         lib/KymoCore/src/endpoint/features/kymo_plot.h \
                         lib/KymoCore/src/endpoint/features/kymo_trace.h \
                         lib/KymoCore/src/endpoint/features/kymo_watch.h \
                         lib/KymoCore/src/endpoint/kymo_endpoint.h \
                         lib/KymoCore/src/kymo_config.h \
                         lib/KymoCore/src/kymo_types.h \
                         lib/KymoCore/src/KymoCore.h \
                         lib/KymoCore/src/telemetry/kymo_memory.h \
                         lib/KymoCore/src/telemetry/kymo_protocol.h \
                         lib/KymoCore/src/telemetry/kymo_runtime.h \
                         lib/KymoCore/src/telemetry/kymo_sender.h \
                         lib/KymoCore/src/trace/kymo_instrumentation.h \
                         lib/KymoCore/src/trace/kymo_trace.h \
                         lib/KymoCore/src/trace/kymo_trace_protocol.h \
                         lib/KymoCore/src/transport/kymo_mux.h \
                         lib/KymoCore/src/transport/kymo_tx.h \
                         include/demo_selection.h \
                         examples/common/arduino_serial_config.h \
                         examples/common/kymo_arduino.h \
                         examples/esp32/measurement_signals/include/Config.h \
                         examples/esp32/measurement_signals/include/Types.h \
                         examples/esp32/measurement_signals/include/Waveforms.h \
                         examples/esp32/trace_uart/src/kymo_freertos_trace_adapter.h \
                         examples/esp32/trace_uart/src/kymo_freertos_trace_hooks.h \
                         examples/esp32/runtime_freertos/include/Config.h \
                         examples/esp32/runtime_freertos/include/Types.h \
                         examples/stm32/adapters/kymo_stm32.h \
                         examples/stm32/uart_example/src/board.h \
                         examples/integration/include/app_values.h \
                         examples/integration/include/features/kymo_memory.h \
                         examples/integration/include/features/kymo_param.h \
                         examples/integration/include/features/kymo_plot.h \
                         examples/integration/include/features/kymo_trace.h \
                         examples/integration/include/features/kymo_watch.h \
                         examples/integration/include/kymo_init.h \
                         examples/integration/include/kymo_port.h \
                         examples/integration/include/kymo_user_config.h
FILE_PATTERNS          = *.h *.dox
RECURSIVE              = NO
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
# Opaque recorder storage and macro-expansion helpers are not application APIs.
# Keep the released Core checkout unchanged; document its callable interfaces.
EXCLUDE_SYMBOLS        = KYMO_TRACE_DETAIL_* __COUNTER__ KYMO_TRACE_SCOPE_IMPL
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .
SOURCE_BROWSER        = YES
INLINE_SOURCES        = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = YES
HAVE_DOT               = NO
ENABLE_PREPROCESSING  = YES
PREDEFINED            = __cplusplus DOXYGEN HAL_UART_MODULE_ENABLED \
                         KYMO_EXAMPLE_MULTIDIMENSIONAL KYMO_ENABLED=1 \
                         KYMO_ENABLE_RUNTIME=1 KYMO_ENABLE_X=1 KYMO_ENABLE_Z=1 \
                         KYMO_ENABLE_TIMESTAMP=1 KYMO_ENABLE_CRC=1 \
                         KYMO_ENABLE_DECODER=1 KYMO_ENABLE_CPP=1 \
                         KYMO_ENABLE_ENDPOINT=1 KYMO_ENABLE_TX=1 \
                         KYMO_ENABLE_PARAMETERS=1 KYMO_ENABLE_WATCH=1 KYMO_ENABLE_MEMORY=1 \
                         KYMO_ENABLE_TRACE=1 KYMO_ENABLE_TRACE_ISR=0 \
                         KYMO_ENABLE_TRACE_SCHEDULER=0 KYMO_ENABLE_TRACE_FLOW=0
QUIET                 = YES
WARNINGS              = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_LOGFILE           = docs/api/warnings.log
